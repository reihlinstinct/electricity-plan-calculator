      {
        "start": "2026-10-02T00:15",
        "kwh": 0.5,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "quoted metadata with embedded newline",
    "csv": "\"metadata\n00-00000001\",צריכה,02/10/2026,00:15,0.5,0\n",
