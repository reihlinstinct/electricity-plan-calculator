[
  {
    "name": "six columns",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,0.5,0\n",
    "expected": [
      {
        "start": "2026-10-02T00:15",
        "kwh": 0.5,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "optional feed column absent",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,0.5\n",
    "expected": [
      {
        "start": "2026-10-02T00:15",
        "kwh": 0.5,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "blank feed",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,0.5,\n",
    "expected": [
      {
        "start": "2026-10-02T00:15",
        "kwh": 0.5,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "blank energy defaults to zero",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,,0\n",
    "expected": [
      {
        "start": "2026-10-02T00:15",
        "kwh": 0.0,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "feed-in row ignored",
    "csv": "00-00000001,הזרמה,02/10/2026,00:15,0.5,0\n",
    "expected": []
  },
  {
    "name": "metadata-shaped row ignored",
    "csv": "metadata,צריכה,02/10/2026,00:15,0.5,0\n",
    "expected": []
  },
  {
    "name": "quoted comma in extra column",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,0.5,0,\"note, extra\"\n",
    "expected": [
      {
        "start": "2026-10-02T00:15",
        "kwh": 0.5,
        "feed": 0.0
      }
    ]
  },
  {
    "name": "quoted newline in extra column",
    "csv": "00-00000001,צריכה,02/10/2026,00:15,0.5,0,\"note\nextra\"\n",
